[Unit]
Description=Novene independent backend
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=novene
Group=novene
WorkingDirectory=/var/www/novene
ExecStart=/usr/bin/node /var/www/novene/deploy/start.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/novene
UMask=0077
MemoryMax=1G
TasksMax=100
[Install]
WantedBy=multi-user.target
